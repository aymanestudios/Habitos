# Copia este archivo como ".env.local" y rellena los valores:
#   cp .env.example .env.local
#
# Los encuentras en el panel de Supabase, en la sección de claves de la API de tu proyecto.

# URL de tu proyecto, por ejemplo https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA (anon / publishable). Es segura en el navegador porque la protegen las políticas RLS.
VITE_SUPABASE_ANON_KEY=tu-clave-publica

# Clave PÚBLICA de los avisos al móvil (VAPID). Opcional: sin ella, los avisos salen como "no configurados".
# Se genera con: npx web-push generate-vapid-keys  (la privada va SOLO a Supabase, nunca aquí)
VITE_VAPID_PUBLIC_KEY=

# IMPORTANTE: no pongas aquí la clave "service_role" ni ninguna clave secreta.
# Todo lo que empieza por VITE_ acaba dentro del código que se descarga el navegador.
